{
  "name": "opreturn-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir=dist",
    "db:migrate:local": "wrangler d1 migrations apply opreturn-monitor --local",
    "db:migrate:remote": "wrangler d1 migrations apply opreturn-monitor --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.118.0"
  }
}
