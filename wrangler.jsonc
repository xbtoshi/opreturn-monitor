{
  // ---- Bitcoin OP_RETURN Message Monitor -------------------------------
  "name": "opreturn-monitor",
  "main": "src/index.ts",
  // Learn articles are Markdown files imported as text (no build step).
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2026-08-05",

  // ---------------------------------------------------------------------------
  // D1 database
  //   Create it first:  wrangler d1 create opreturn-monitor
  //   Then copy the printed database_id below.
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opreturn-monitor",
      "database_id": "947f79ec-b46e-4641-87c5-32be2dd6c0dd",
      "migrations_dir": "migrations"
    }
  ],

  // ---------------------------------------------------------------------------
  // Scheduled cron: runs every 3 minutes. Workers cron supports a minimum of
  // once per minute; this schedule polls every 3 min as recommended in the PRD.
  // ---------------------------------------------------------------------------
  "triggers": {
    "crons": ["*/3 * * * *"]
  },

  // Custom domain for this worker (zone is already active on Cloudflare).
  "routes": [{ "pattern": "opreturn.xyz", "custom_domain": true }],

  // ---------------------------------------------------------------------------
  // Vars (non-secret config). These ship with the worker.
  // ---------------------------------------------------------------------------
  "vars": {
    "SITE_URL": "https://opreturn.xyz",
    "OPENAI_MODEL": "deepseek-v4-flash",
    "OPENAI_API_BASE": "https://opencode.ai/zen/go/v1",
    // Esplora-style API. btc.tx.taxi is a full mempool-electrs instance that
    // serves raw blocks 2-3x faster than mempool.space; the fallbacks are
    // tried in order when it fails.
    "MEMPOOL_BASE_URL": "https://btc.tx.taxi",
    "MEMPOOL_FALLBACKS": "https://mempool.space,https://blockstream.info",
    "AI_MAX_PER_RUN": "20",
    "AI_DELAY_MS": "50",
    "AI_BATCH_SIZE": "10",
    // Full-chain OP_RETURN ingestion. Both flags off = the worker only polls
    // monitored addresses (the pre-explorer behaviour). Turn INGEST_FORWARD on
    // first and watch GET /api/admin/ingest/status; enable INGEST_BACKFILL once
    // the forward cursor keeps up with the tip.
    "INGEST_FORWARD": "1",
    "INGEST_BACKFILL": "1",
    "INGEST_MAX_BLOCKS_PER_RUN": "3",
    "INGEST_TIME_BUDGET_MS": "60000",
    "BACKFILL_DAYS": "30",
    // IndexNow hub: new human-message pages are pushed here every cron run
    // (secret INDEXNOW_HUB_TOKEN enables it; see README "IndexNow").
    "INDEXNOW_HUB_URL": "https://indexnow.kyc.rip/v1/submit",
    "INDEXNOW_HOST": "opreturn.xyz"
    // Set these to real values in production, ideally via wrangler secret put.
  },

  // ---------------------------------------------------------------------------
  // Secrets (do NOT put real values in this file):
  //   wrangler secret put OPENAI_API_KEY
  //   wrangler secret put ADMIN_KEY
  //   wrangler secret put CRON_SECRET
  // ---------------------------------------------------------------------------
}
