{
  // ---- Bitcoin OP_RETURN Message Monitor -------------------------------
  "name": "opreturn-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",

  // ---------------------------------------------------------------------------
  // D1 database
  //   Create it first:  wrangler d1 create opreturn-monitor
  //   Then copy the printed database_id below.
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opreturn-monitor",
      "database_id": "947f79ec-b46e-4641-87c5-32be2dd6c0dd",
      "migrations_dir": "migrations"
    }
  ],

  // ---------------------------------------------------------------------------
  // Scheduled cron: runs every 3 minutes. Workers cron supports a minimum of
  // once per minute; this schedule polls every 3 min as recommended in the PRD.
  // ---------------------------------------------------------------------------
  "triggers": {
    "crons": ["*/3 * * * *"]
  },

  // Custom domain for this worker (zone is already active on Cloudflare).
  "routes": [{ "pattern": "opreturn.xyz", "custom_domain": true }],

  // ---------------------------------------------------------------------------
  // Vars (non-secret config). These ship with the worker.
  // ---------------------------------------------------------------------------
  "vars": {
    "SITE_URL": "https://opreturn.xyz",
    "OPENAI_MODEL": "deepseek-v4-flash",
    "OPENAI_API_BASE": "https://opencode.ai/zen/go/v1",
    "MEMPOOL_BASE_URL": "https://mempool.space",
    "AI_MAX_PER_RUN": "20",
    "AI_DELAY_MS": "50",
    "AI_BATCH_SIZE": "10"
    // Set these to real values in production, ideally via wrangler secret put.
  },

  // ---------------------------------------------------------------------------
  // Secrets (do NOT put real values in this file):
  //   wrangler secret put OPENAI_API_KEY
  //   wrangler secret put ADMIN_KEY
  //   wrangler secret put CRON_SECRET
  // ---------------------------------------------------------------------------
}
